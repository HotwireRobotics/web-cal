{
  "name": "hotwire-web-cal",
  "private": true,
  "description": "Hotwire Robotics meeting schedule as a subscribable calendar on GitHub Pages",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
